<view class="page">
  <view class="card"><view class="form-row"><text class="form-row__label">收货人</text><input class="form-row__input" value="{{form.receiverName}}" data-field="receiverName" bindinput="input" placeholder="姓名" /></view><view class="form-row"><text class="form-row__label">手机号</text><input class="form-row__input" value="{{form.receiverPhone}}" data-field="receiverPhone" bindinput="input" type="number" maxlength="11" placeholder="手机号" /></view><view class="form-row" bindtap="chooseAddress"><text class="form-row__label">所在地区</text><text class="form-row__value">{{regionText || '选择微信收货地址'}}</text></view><view class="form-row"><text class="form-row__label">详细地址</text><input class="form-row__input" value="{{form.detailAddress}}" data-field="detailAddress" bindinput="input" placeholder="街道、门牌号等" /></view><view class="form-row" bindtap="toggleDefault"><text class="form-row__label">设为默认</text><text class="form-row__value">{{form.isDefault ? '已设为默认' : '否'}}</text></view></view>
  <button class="btn-primary save-button" loading="{{loading}}" disabled="{{loading}}" bindtap="save">保存地址</button>
</view>
