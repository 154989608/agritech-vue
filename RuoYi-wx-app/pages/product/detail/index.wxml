<view class="page detail-page">
  <swiper class="detail-swiper" indicator-dots wx:if="{{images.length}}"><swiper-item wx:for="{{images}}" wx:key="*this"><image class="detail-swiper__image" src="{{item}}" mode="aspectFill" /></swiper-item></swiper>
  <view class="card"><view class="detail-price-row"><text class="price">¥{{product.priceText}}</text><text class="detail-price-row__origin" wx:if="{{product.marketPriceCent > product.priceCent}}">¥{{product.marketPriceText}}</text></view><text class="detail-sales" wx:if="{{product.soldOut}}">当前商品已售罄</text><text class="detail-hero__title">{{product.productName}}</text><text class="detail-hero__desc">{{product.subtitle}}</text></view>
  <view class="card"><view class="section-title"><text class="section-title__main">选择规格</text></view><view class="chip-row"><text wx:for="{{product.skus}}" wx:key="skuId" class="spec-item {{selectedSkuId === item.skuId ? 'is-selected' : ''}} {{item.soldOut ? 'is-disabled' : ''}}" bindtap="selectSku" data-id="{{item.skuId}}">{{item.skuName}}{{item.soldOut ? '（售罄）' : ''}}</text></view><view class="stepper"><text class="stepper__btn" bindtap="changeQuantity" data-delta="-1">-</text><text class="stepper__value">{{quantity}}</text><text class="stepper__btn" bindtap="changeQuantity" data-delta="1">+</text></view></view>
  <view class="card" wx:if="{{params.length}}"><view class="section-title"><text class="section-title__main">商品信息</text></view><view wx:for="{{params}}" wx:key="key" class="summary-row"><text>{{item.name || item.key}}</text><text class="muted">{{item.value}}</text></view></view>
  <view class="card" wx:if="{{product.detailHtml}}"><view class="section-title"><text class="section-title__main">商品详情</text></view><rich-text nodes="{{product.detailHtml}}" /></view>
  <view class="detail-bar"><button class="btn-secondary detail-bar__btn" bindtap="goCart">购物车</button><button class="btn-primary detail-bar__btn" bindtap="addCart">加入购物车</button><button class="btn-primary detail-bar__btn detail-bar__btn--main" bindtap="buyNow">立即购买</button></view>
</view>
