<view class="page"><view class="card coupon-tabs"><text class="coupon-tab {{tab === 'available' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="available">可领取</text><text class="coupon-tab {{tab === 'mine' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="mine">我的优惠券</text></view><view class="card" wx:for="{{coupons}}" wx:key="couponId"><view class="coupon"><view><text class="coupon__amount">¥{{item.discountText}}</text><text class="coupon__threshold">满 ¥{{item.thresholdText}} 可用</text></view><view class="coupon__body"><text class="coupon__name">{{item.couponName || item.couponNameSnapshot}}</text><text class="coupon__date">{{tab === 'available' ? '领取截止 ' + item.receiveEndTime : '有效期至 ' + item.validEndTime}}</text></view><button wx:if="{{tab === 'available'}}" class="btn-primary coupon__button" disabled="{{item.received}}" loading="{{claimingId === item.couponId}}" bindtap="claim" data-id="{{item.couponId}}">{{item.received ? '已领取' : '领取'}}</button><text wx:else class="chip chip--warm">{{item.status}}</text></view></view><view wx:if="{{!loading && !coupons.length}}" class="card empty"><text class="empty__title">暂无优惠券</text></view></view>
