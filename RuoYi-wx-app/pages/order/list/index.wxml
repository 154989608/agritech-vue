<view class="page">
  <view class="card">
    <view class="section-title"><text class="section-title__main">订单列表</text><text class="section-title__sub">交易状态</text></view>
    <view class="filter-row"><view class="filter-pill {{activeFilter === item.value ? 'is-active' : ''}}" wx:for="{{filters}}" wx:key="value" bindtap="switchFilter" data-value="{{item.value}}">{{item.label}}</view></view>
  </view>
  <view class="card" wx:for="{{orderList}}" wx:key="orderNo" bindtap="goDetail" data-order-no="{{item.orderNo}}">
    <view class="order-head"><text class="order-head__sn">订单号 {{item.orderNo}}</text><text class="chip chip--warm">{{item.statusText}}</text></view>
    <view class="order-goods">
      <view class="order-goods__item" wx:for="{{item.items}}" wx:key="orderItemId">
        <image class="order-goods__cover" src="{{item.imageUrlSnapshot}}" mode="aspectFill"></image>
        <view class="order-goods__body"><text class="order-goods__title">{{item.productNameSnapshot}}</text><text class="order-goods__desc">{{item.skuNameSnapshot}} x {{item.quantity}}</text></view>
      </view>
    </view>
    <view class="order-foot"><text class="muted">共 {{item.itemCount}} 件</text><text class="price">¥{{item.payableAmountText}}</text></view>
  </view>
  <view wx:if="{{!loading && !orderList.length}}" class="card empty">暂无订单</view>
</view>
