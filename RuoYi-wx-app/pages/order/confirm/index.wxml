<view class="page confirm-page"><view class="card"><view class="section-title"><text class="section-title__main">收货地址</text></view><view wx:if="{{address.addressId}}" class="address-card"><text class="address-card__name">{{address.receiverName}}</text><text class="address-card__phone">{{address.receiverPhone}}</text><text class="address-card__detail">{{address.provinceName}}{{address.cityName}}{{address.districtName}}{{address.detailAddress}}</text></view><view wx:else class="empty"><text class="empty__desc">登录后选择收货地址</text></view></view>
  <view class="card"><view class="section-title"><text class="section-title__main">商品清单</text></view><view class="confirm-item" wx:for="{{preview.items}}" wx:key="skuId"><image class="confirm-item__cover" src="{{item.imageUrl}}" mode="aspectFill"/><view class="confirm-item__body"><text class="confirm-item__title">{{item.productName}}</text><text class="confirm-item__sku">{{item.skuName}} x {{item.quantity}}</text></view><text class="confirm-item__price">¥{{item.lineAmountText}}</text></view></view>
  <view class="submit-bar"><text class="submit-bar__total">合计 ¥{{preview.payableAmountText}}</text><button class="btn-primary submit-bar__btn" loading="{{loading}}" bindtap="submitOrder">提交订单</button></view>
</view>
