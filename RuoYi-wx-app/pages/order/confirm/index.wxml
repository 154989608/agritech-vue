<view class="page confirm-page"><view class="card"><view class="section-title"><text class="section-title__main">收货地址</text><text class="section-title__sub" bindtap="chooseAddress">{{address.addressId ? '更换' : '选择地址'}}</text></view><view wx:if="{{address.addressId}}" class="address-card" bindtap="chooseAddress"><text class="address-card__name">{{address.receiverName}} {{address.receiverPhone}}</text><text class="address-card__detail">{{address.provinceName}}{{address.cityName}}{{address.districtName}}{{address.detailAddress}}</text></view><view wx:else class="empty" bindtap="chooseAddress"><text class="empty__desc">请选择收货地址</text></view></view>
  <view wx:if="{{preview}}" class="card"><view class="section-title"><text class="section-title__main">商品清单</text></view><view class="confirm-item" wx:for="{{preview.items}}" wx:key="skuId"><image class="confirm-item__cover" src="{{item.imageUrl}}" mode="aspectFill"/><view class="confirm-item__body"><text class="confirm-item__title">{{item.productName}}</text><text class="confirm-item__sku">{{item.skuName}} x {{item.quantity}}</text></view><text class="confirm-item__price">¥{{item.lineAmountText}}</text></view><view class="amount-row"><text>商品金额</text><text>¥{{preview.productAmountText}}</text></view><view class="amount-row"><text>运费</text><text>¥{{preview.freightAmountText}}</text></view><view class="amount-row"><text>优惠</text><text>-¥{{preview.discountAmountText}}</text></view></view>
  <view class="card"><view class="section-title"><text class="section-title__main">优惠券</text><text class="section-title__sub">不使用可再次点击已选券</text></view><view wx:if="{{coupons.length}}" class="coupon-list"><view class="coupon-option {{memberCouponId === item.memberCouponId ? 'is-selected' : ''}}" wx:for="{{coupons}}" wx:key="memberCouponId" bindtap="selectCoupon" data-id="{{item.memberCouponId}}"><text>{{item.couponNameSnapshot}}</text><text>满¥{{item.thresholdText}}减¥{{item.discountText}}</text></view></view><text wx:else class="muted">暂无可用优惠券</text></view>
  <view class="submit-bar"><text class="submit-bar__total">合计 ¥{{preview.payableAmountText}}</text><button class="btn-primary submit-bar__btn" loading="{{loading}}" disabled="{{loading}}" bindtap="submitOrder">提交订单</button></view>
</view>
