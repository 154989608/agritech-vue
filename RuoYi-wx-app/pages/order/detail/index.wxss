.order-status, .item, .amount-row { display: flex; align-items: center; justify-content: space-between; }
.order-progress { display: flex; align-items: flex-start; }
.order-progress__step { position: relative; flex: 1; color: #94a3b8; font-size: 20rpx; text-align: center; }
.order-progress__step:not(:last-child)::after { position: absolute; top: 12rpx; left: calc(50% + 14rpx); width: calc(100% - 28rpx); height: 2rpx; background: #e2e8f0; content: ''; }
.order-progress__dot { width: 20rpx; height: 20rpx; margin: 2rpx auto 10rpx; border-radius: 50%; background: #e2e8f0; }
.order-progress__step.is-active { color: #4f7c39; }
.order-progress__step.is-active .order-progress__dot { background: #4f7c39; }
.order-progress__step.is-current { font-weight: 700; }
.order-canceled { border-left: 6rpx solid #94a3b8; }
.order-canceled__title, .order-canceled__desc { display: block; }
.order-canceled__title { font-weight: 700; }
.order-canceled__desc { margin-top: 8rpx; color: #64748b; font-size: 22rpx; }
.address-name, .address-detail { display: block; margin-top: 12rpx; }
.address-name { font-weight: 700; }
.address-detail, .item__body .muted { color: #64748b; font-size: 24rpx; }
.item { padding: 16rpx 0; }
.item + .item { border-top: 1px solid #eef2f7; }
.item__cover { width: 96rpx; height: 96rpx; border-radius: 16rpx; flex: none; }
.item__body { flex: 1; margin: 0 16rpx; }
.item__body text { display: block; }
.amount-row { margin-top: 16rpx; color: #475569; font-size: 24rpx; }
.amount-row--total { font-size: 28rpx; font-weight: 700; }
.action-bar { display: flex; justify-content: flex-end; gap: 16rpx; }
.action-bar__button { margin: 0; border-radius: 16rpx; font-size: 26rpx; }
