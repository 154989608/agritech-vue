<view class="page" wx:if="{{order}}">
  <view class="card"><view class="order-status"><text class="section-title__main">{{order.statusText}}</text><text class="section-title__sub">订单号 {{order.orderNo}}</text></view></view>
  <view wx:if="{{order.orderStatus === 'CANCELED'}}" class="card order-canceled"><text class="order-canceled__title">订单已取消，库存已释放</text><text class="order-canceled__desc">{{order.cancelReason || '该订单不会再进入发货流程。'}}</text></view>
  <view wx:else class="card"><view class="order-progress"><view wx:for="{{order.stages}}" wx:key="name" class="order-progress__step {{item.active ? 'is-active' : ''}} {{item.current ? 'is-current' : ''}}"><view class="order-progress__dot"></view><text>{{item.name}}</text></view></view></view>
  <view class="card"><view class="section-title"><text class="section-title__main">收货地址</text></view><text class="address-name">{{order.receiverName}} {{order.receiverPhone}}</text><text class="address-detail">{{order.provinceName}}{{order.cityName}}{{order.districtName}}{{order.detailAddress}}</text></view>
  <view class="card"><view class="section-title"><text class="section-title__main">商品信息</text></view><view class="item" wx:for="{{order.items}}" wx:key="orderItemId"><image class="item__cover" src="{{item.imageUrlSnapshot}}" mode="aspectFill"></image><view class="item__body"><text>{{item.productNameSnapshot}}</text><text class="muted">{{item.skuNameSnapshot}} x {{item.quantity}}</text></view><text class="price">¥{{item.payableAmountText}}</text></view><view class="amount-row"><text>商品金额</text><text>¥{{order.productAmountText}}</text></view><view class="amount-row"><text>运费</text><text>¥{{order.freightAmountText}}</text></view><view class="amount-row"><text>优惠</text><text>-¥{{order.discountAmountText}}</text></view><view class="amount-row amount-row--total"><text>应付金额</text><text class="price">¥{{order.payableAmountText}}</text></view></view>
  <view wx:if="{{order.logisticsNo}}" class="card"><text class="section-title__main">物流信息</text><text class="address-detail">{{order.logisticsCompany}} {{order.logisticsNo}}</text></view>
  <view class="action-bar"><button wx:if="{{order.canCancel}}" class="btn-secondary action-bar__button" bindtap="cancel">取消订单</button><button wx:if="{{order.canConfirmReceipt}}" class="btn-primary action-bar__button" bindtap="confirmReceipt">确认收货</button></view>
</view>
