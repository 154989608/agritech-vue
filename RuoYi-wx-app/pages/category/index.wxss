.category-layout {
  display: flex;
  gap: 16rpx;
  padding: 12rpx;
}

.category-nav {
  width: 180rpx;
  flex: none;
}

.category-nav__item {
  margin-bottom: 10rpx;
  padding: 18rpx 16rpx;
  border-radius: 14rpx;
  background: #f3f7f3;
}

.category-nav__item.is-active {
  background: #276749;
  color: #ffffff;
}

.category-nav__title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.category-nav__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.category-panel {
  flex: 1;
}

.category-banner {
  padding: 22rpx;
  border-radius: 14rpx;
  background: #e7f3e6;
  color: #1f5138;
  margin-bottom: 16rpx;
}

.category-banner__title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.category-banner__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
}

.category-grid {
  gap: 18rpx;
}

.category-grid--single {
  display: block;
}

.category-grid--single > .product-card {
  display: flex;
  gap: 14rpx;
  width: 100%;
  margin-bottom: 12rpx;
  padding: 12rpx;
  border-radius: 14rpx;
}

.category-grid--single > .product-card:last-child {
  margin-bottom: 0;
}

.category-grid .product-card {
  background: #f6f9f6;
}

.product-card__cover {
  width: 156rpx;
  height: 156rpx;
  border-radius: 12rpx;
  flex: none;
  background: #e6ece5;
}

.product-card__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.product-card__title {
  color: #26352b;
  font-size: 27rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card__desc {
  display: -webkit-box;
  margin-top: 8rpx;
  color: #748178;
  font-size: 22rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}
