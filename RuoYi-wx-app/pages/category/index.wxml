<view class="page page--tab">
  <view class="card card--soft"><view class="section-title"><text class="section-title__main">商品分类</text></view><view class="search-bar" bindtap="goSearch"><text class="search-bar__icon">搜</text><text class="search-bar__text">搜索商品、产地或分类</text></view></view>
  <view class="card category-layout"><view class="category-nav"><view wx:for="{{categories}}" wx:key="categoryId" class="category-nav__item {{activeCategoryId === item.categoryId ? 'is-active' : ''}}" bindtap="selectCategory" data-id="{{item.categoryId}}"><text class="category-nav__title">{{item.categoryName}}</text><text class="category-nav__desc">{{item.children.length}} 个子分类</text></view></view>
    <view class="category-panel"><view class="category-banner"><text class="category-banner__title">{{currentCategory.categoryName}}</text><text class="category-banner__desc">真实在售商品</text></view><view class="category-grid category-grid--single"><view class="product-card" wx:for="{{categoryProducts}}" wx:key="productId" bindtap="goDetail" data-id="{{item.productId}}"><image class="product-card__cover" src="{{item.mainImage}}" mode="aspectFill" /><view class="product-card__body"><text class="product-card__title">{{item.productName}}</text><text class="product-card__desc">{{item.subtitle}}</text><view class="product-card__foot"><text class="price">¥{{item.priceText}}</text><text wx:if="{{item.soldOut}}" class="muted">已售罄</text></view></view></view></view>
      <view wx:if="{{!loading && !categoryProducts.length}}" class="empty"><text class="empty__title">暂无商品</text></view>
    </view></view>
  <app-tabbar current="/pages/category/index" />
</view>
