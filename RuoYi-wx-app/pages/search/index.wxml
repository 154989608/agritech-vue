<view class="page"><view class="card search-page__bar"><input class="input" placeholder="搜索商品、产地或分类" value="{{keyword}}" bindinput="onInput" bindconfirm="onConfirm" confirm-type="search" /></view>
  <view class="card" wx:if="{{history.length}}"><view class="section-title"><text class="section-title__main">最近搜索</text><text class="section-title__sub" bindtap="clearHistory">清空</text></view><view class="search-tags"><view class="chip chip--warm" wx:for="{{history}}" wx:key="*this" bindtap="chooseKeyword" data-keyword="{{item}}">{{item}}</view></view></view>
  <view class="card"><view class="section-title"><text class="section-title__main">搜索结果</text><text class="section-title__sub">{{results.length}} 件</text></view><view wx:if="{{results.length}}"><view class="search-result" wx:for="{{results}}" wx:key="productId" bindtap="goDetail" data-id="{{item.productId}}"><image class="search-result__cover" src="{{item.mainImage}}" mode="aspectFill" /><view class="search-result__body"><text class="search-result__title">{{item.productName}}</text><text class="search-result__desc">{{item.subtitle}}</text><view class="search-result__foot"><text class="price">¥{{item.priceText}}</text><text wx:if="{{item.soldOut}}" class="muted">已售罄</text></view></view></view></view><view wx:elif="{{!loading}}" class="empty"><text class="empty__title">没有找到结果</text><text class="empty__desc">换个关键词再试试。</text></view></view>
</view>
