page {
  background: #f3f6f2;
  color: #1d2b22;
  font-size: 28rpx;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f3f6f2;
}

.page--tab {
  padding-bottom: 190rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 61, 40, 0.06);
  box-sizing: border-box;
}

.card--soft {
  background: #f7fbf5;
  box-shadow: inset 0 0 0 1rpx #e1eddf;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 20rpx;
}

.section-title__main {
  font-size: 32rpx;
  font-weight: 700;
}

.section-title__sub {
  color: #3f7550;
  font-size: 24rpx;
}

.subtle,
.muted {
  color: #748178;
}

.btn-primary,
.btn-secondary {
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  box-sizing: border-box;
}

.btn-primary {
  background: #276749;
  color: #ffffff;
}

.btn-secondary {
  background: #e6f2e6;
  color: #276749;
}

.pill,
.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #e7f3e6;
  color: #276749;
}

.chip--warm {
  background: #fff1dc;
  color: #b84b1f;
}

.search-bar {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx #dce9dc;
}

.search-bar__text {
  margin-left: 12rpx;
  color: #64748b;
  font-size: 26rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  min-height: 84rpx;
  background: #f8fbf8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-2 > view {
  width: calc(50% - 10rpx);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  color: #d94d30;
  font-weight: 700;
}

.price__small {
  font-size: 22rpx;
  font-weight: 500;
}

.empty {
  padding: 72rpx 32rpx;
  text-align: center;
  color: #748178;
}
