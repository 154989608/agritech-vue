<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.shop.MallMemberMapper">
 <resultMap id="MemberResult" type="com.ruoyi.system.domain.shop.MallMember"><id property="memberId" column="member_id"/><result property="nickname" column="nickname"/><result property="avatarUrl" column="avatar_url"/><result property="phone" column="phone"/><result property="status" column="status"/><result property="createTime" column="create_time"/></resultMap><resultMap id="MemberAuthResult" type="com.ruoyi.system.domain.shop.MallMember" extends="MemberResult"><result property="appId" column="app_id"/><result property="openId" column="open_id"/><result property="unionId" column="union_id"/></resultMap>
 <resultMap id="AddressResult" type="com.ruoyi.system.domain.shop.MallMemberAddress"><id property="addressId" column="address_id"/><result property="memberId" column="member_id"/><result property="receiverName" column="receiver_name"/><result property="receiverPhone" column="receiver_phone"/><result property="provinceCode" column="province_code"/><result property="provinceName" column="province_name"/><result property="cityCode" column="city_code"/><result property="cityName" column="city_name"/><result property="districtCode" column="district_code"/><result property="districtName" column="district_name"/><result property="detailAddress" column="detail_address"/><result property="isDefault" column="is_default"/></resultMap>
 <select id="selectMemberList" parameterType="com.ruoyi.system.domain.shop.MallMember" resultMap="MemberResult">SELECT member_id,nickname,avatar_url,phone,status,create_time FROM mall_member <where>1=1 <if test="nickname!=null and nickname!=''">AND nickname LIKE concat('%',#{nickname},'%')</if><if test="phone!=null and phone!=''">AND phone LIKE concat('%',#{phone},'%')</if><if test="status!=null and status!=''">AND status=#{status}</if></where> ORDER BY member_id DESC</select>
 <select id="selectMemberById" resultMap="MemberResult">SELECT member_id,nickname,avatar_url,phone,status,create_time FROM mall_member WHERE member_id=#{memberId}</select>
 <select id="selectMemberByAppOpen" resultMap="MemberAuthResult">SELECT member_id,app_id,open_id,union_id,nickname,avatar_url,phone,status,create_time FROM mall_member WHERE app_id=#{appId} AND open_id=#{openId}</select><insert id="insertAppMember" useGeneratedKeys="true" keyProperty="memberId">INSERT INTO mall_member(app_id,open_id,union_id,nickname,status,last_login_time) VALUES(#{appId},#{openId},#{unionId},'', '0',CURRENT_TIMESTAMP(3))</insert><update id="updateMemberLogin">UPDATE mall_member SET last_login_time=CURRENT_TIMESTAMP(3) WHERE member_id=#{memberId}</update>
 <select id="selectAddressesByMemberId" resultMap="AddressResult">SELECT address_id,member_id,receiver_name,receiver_phone,province_code,province_name,city_code,city_name,district_code,district_name,detail_address,is_default FROM mall_member_address WHERE member_id=#{memberId} AND del_flag='0' ORDER BY is_default DESC,address_id DESC</select>
 <update id="updateMemberStatus" parameterType="com.ruoyi.system.domain.shop.MallMember">UPDATE mall_member SET status=#{status} WHERE member_id=#{memberId}</update>
</mapper>
